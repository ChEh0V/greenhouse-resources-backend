{
  "info": {
    "name": "Ресурсы теплицы на Севере",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 GET список ресурсов (фильтр min_value)",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/api/greenhouse_resources?min_value=5"
      }
    },
    {
      "name": "02 GET лента (без ид / ?resource_id=1&next=true)",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/api/greenhouse_resources/feed?resource_id=1&next=true"
      }
    },
    {
      "name": "03 GET черновик",
      "request": {
        "method": "GET",
        "url": "http://localhost:8000/api/greenhouse_resources/draft",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id=ВСТАВИТЬ_ИЗ_БРАУЗЕРА",
            "type": "text"
          }
        ]
      }
    },
    {
      "name": "04 POST добавление ресурса с изображением и видео",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "resource_name",
              "value": "Досвечивание LED",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "C:/greenhouse/docs/postman_files/led_lighting_new.jpg"
            },
            {
              "key": "video",
              "type": "file",
              "src": "C:/greenhouse/docs/postman_files/led_lighting_new.mp4"
            }
          ]
        },
        "url": "http://localhost:8000/api/greenhouse_resources",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id=ВСТАВИТЬ_ИЗ_БРАУЗЕРА",
            "type": "text"
          }
        ]
      }
    },
    {
      "name": "05 PUT публикация ресурса",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id=ВСТАВИТЬ_ИЗ_БРАУЗЕРА",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"short_description\": \"Светодиодные модули для досвечивания рассады в полярную ночь\",\n  \"unit\": \"кВт·ч\",\n  \"min_value\": 20\n}"
        },
        "url": "http://localhost:8000/api/greenhouse_resources/10/publish"
      }
    },
    {
      "name": "06 DELETE удаление ресурса",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:8000/api/greenhouse_resources/3",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id=ВСТАВИТЬ_ИЗ_БРАУЗЕРА",
            "type": "text"
          }
        ]
      }
    },
    {
      "name": "07 POST лайк ресурса",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "session_id=ВСТАВИТЬ_ИЗ_БРАУЗЕРА",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_liked\": 1\n}"
        },
        "url": "http://localhost:8000/api/greenhouse_resources/4/like"
      }
    },
    {
      "name": "08 POST регистрация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"technologist\",\n  \"password\": \"technologist123\"\n}"
        },
        "url": "http://localhost:8000/api/greenhouse_users/register"
      }
    },
    {
      "name": "09 POST аутентификация",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"chekhovich\",\n  \"password\": \"chekhovich123\"\n}"
        },
        "url": "http://localhost:8000/api/greenhouse_users/login"
      }
    },
    {
      "name": "10 POST деавторизация",
      "request": {
        "method": "POST",
        "url": "http://localhost:8000/api/greenhouse_users/logout",
        "header": [
          {
            "key": "Cookie",
            "value": "session_id=ВСТАВИТЬ_ИЗ_БРАУЗЕРА",
            "type": "text"
          }
        ]
      }
    }
  ]
}
